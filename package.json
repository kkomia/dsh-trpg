{
  "name": "dsh-trpg",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "跑团桌 · TRPG Table — 局域网多人 AI 跑团 DSH 插件",
  "license": "MIT",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p packages/protocol && tsc -p packages/engine && tsc -p packages/content && tsc -p packages/rooms && tsc -p packages/dsh-trpg-table",
    "test": "node --test \"packages/engine/test/*.test.ts\" \"packages/protocol/test/*.test.ts\" \"packages/content/test/*.test.ts\" \"packages/rooms/test/*.test.ts\" \"packages/dsh-trpg-table/test/*.test.ts\"",
    "test:e2e": "node scripts/smoke-room.mjs",
    "test:gm": "node scripts/smoke-gm.mjs",
    "probe:gm": "node scripts/probe-live-gm.mjs",
    "build": "node scripts/build.mjs",
    "content:pack": "node scripts/content-pack.mjs",
    "pack:plugin": "node scripts/build.mjs && node scripts/pack-plugin.mjs",
    "demo": "node scripts/cli-demo.mjs"
  },
  "devDependencies": {
    "@dsh-trpg/content": "workspace:*",
    "@dsh-trpg/engine": "workspace:*",
    "@dsh-trpg/protocol": "workspace:*",
    "@dsh-trpg/rooms": "workspace:*",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
